# Required for Conductor and AI call turns
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Optional alternative provider used by the modular runtime
LLM_PROVIDER=groq
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Optional telephony and speech services
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_AGENT_ID=
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-asteria-en
PUBLIC_BASE_URL=http://localhost:8000

# Optional. Defaults to local SQLite storage.
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
